# --- Общее ---
# Адрес форума, по умолчанию https://forum.minecraft-galaxy.ru
# FORUM_BASE_URL=
# Минимальный интервал между запросами к форуму, мс (общий на процесс)
FORUM_MIN_INTERVAL_MS=300
# Таймаут одного запроса к форуму, мс
FORUM_TIMEOUT_MS=15000
# debug | info | warn | error
LOG_LEVEL=info

# --- Только stdio (локальный режим) ---
# Если заданы, включаются инструменты от лица игрока
FORUM_LOGIN=
FORUM_PASSWORD=

# --- Только http (публичный режим) ---
HOST=0.0.0.0
PORT=3000
# Через запятую; пусто = без проверки Host (за reverse-proxy задай свой домен)
ALLOWED_HOSTS=
